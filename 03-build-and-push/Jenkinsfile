pipeline {
    agent any
    environment {
        REPOSITORY = 'https://github.com/andreazecchino/poc-py-llm'
        BRANCH = 'develop'
        REGISTRY = 'registry.local'
        IMAGE = 'poc-py-llm'
    }
    options {
        buildDiscarder logRotator(
            artifactDaysToKeepStr: '',
            artifactNumToKeepStr: '3',
            daysToKeepStr: '',
            numToKeepStr: '3')
        disableConcurrentBuilds abortPrevious: true
        disableResume()
        timeout(time: 30, unit: 'MINUTES')
    }
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scmGit(
                    branches: [[name: "$BRANCH"]],
                    extensions: [],
                    userRemoteConfigs: [[url: "$REPOSITORY"]]
                )
                script {
                    env.TAG = env.GIT_COMMIT?.take(8) ?: env.BUILD_ID
                }
            }
        }
        stage('Lint & Unit tests') {
            agent {
                docker {
                    image 'ghcr.io/astral-sh/uv:python3.14-trixie-slim'
                    args '''
                        -u 0:0
                        -v uv-cache:/tmp/uv-cache
                        -v uv-tools:/tmp/uv-tools
                    '''
                    reuseNode true
                }
            }
            environment {
                UV_CACHE_DIR = "/tmp/uv-cache"
                UV_TOOL_DIR = "/tmp/uv-tools"
            }
            steps {
                sh 'uv sync --locked'
                sh 'uv run ruff check .'
                sh 'uv run ruff format --check .'
                sh 'uv run python -m unittest discover -s tests -p "test_*.py" -v'
            }
        }
        stage('Security Scan: Filesystem') {
            agent {
                docker {
                    image 'aquasec/trivy:0.76.1'
                    args '''
                        -u 0:0
                        -v trivy-cache:/tmp/trivy-cache
                        --entrypoint=""
                    '''
                    reuseNode true
                }
            }
            environment {
                TRIVY_CACHE_DIR = "/tmp/trivy-cache"
            }
            steps {
                sh '''
                    trivy fs \
                      --cache-dir "$TRIVY_CACHE_DIR" \
                      --severity HIGH,CRITICAL \
                      --scanners vuln,secret,misconfig \
                      --ignore-unfixed \
                      --exit-code 1 \
                      --format json \
                      --output trivy-fs-report.json \
                      "$WORKSPACE"
                '''
            }
        }
        stage('Build, Verify & Push Docker Image') {
            steps {
                script {
                    def img = docker.build("${REGISTRY}/${IMAGE}:${TAG}")

                    img.inside {
                        sh 'python -c "import sys; print(sys.version)"'
                    }

                    docker.withRegistry("https://${REGISTRY}") {
                        img.push(tag)
                        img.push('latest')
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'trivy-*.json', fingerprint: true, followSymlinks: false
            cleanWs(
                deleteDirs: true,
                notFailBuild: true,
                patterns: [
                    [pattern: 'trivy-*.json', type: 'EXCLUDE'],
                ]
            )
            sh returnStatus: true, script: """
                docker image rm -f \"${REGISTRY}/${IMAGE}\":latest || true
                docker image rm -f \"${REGISTRY}/${IMAGE}\":${TAG} || true
            """
        }
    }
}
